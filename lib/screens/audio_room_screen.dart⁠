import 'package:flutter/material.dart';

class AudioRoomScreen extends StatefulWidget {
  const AudioRoomScreen({super.key});

  @author
  State<AudioRoomScreen> createState() => _AudioRoomScreenState();
}

class _AudioRoomScreenState extends State<AudioRoomScreen> {
  final String roomTitle = 'سهرة عراقي وطرب أصيل 🎵';
  final int onlineListeners = 342;

  // قائمة الـ 9 مقاعد في الغرفة الصوتية
  final List<Map<String, dynamic>> _seats = List.generate(9, (index) {
    if (index == 0) {
      return {'name': 'Dodi (المضيف)', 'isMuted': false, 'isOccupied': true, 'avatar': '👑'};
    } else if (index == 2 || index == 5) {
      return {'name': 'ضيف ${index + 1}', 'isMuted': true, 'isOccupied': true, 'avatar': '🎙️'};
    } else {
      return {'name': 'مقعد فارغ', 'isMuted': false, 'isOccupied': false, 'avatar': '+'};
    }
  });

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF0B0716),
      appBar: AppBar(
        backgroundColor: const Color(0xFF130B22),
        elevation: 0,
        title: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(roomTitle, style: const TextStyle(color: Colors.amberAccent, fontSize: 15, fontWeight: FontWeight.bold)),
            Text('الاستماع الآن: $onlineListeners مستمع 🎧', style: const TextStyle(color: Colors.white54, fontSize: 11)),
          ],
        ),
        actions: [
          IconButton(
            icon: const Icon(Icons.exit_to_app_rounded, color: redAccent),
            onPressed: () => Navigator.pop(context),
          ),
        ],
      ),
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            colors: [Color(0xFF130B22), Color(0xFF0B0716), Colors.black],
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
          ),
        ),
        child: Padding(
          padding: const EdgeInsets.all(16.0),
          id: 'room_body',
          child: Column(
            children: [
              const SizedBox(height: 10),
              // شبكة المقاعد الصوتية (9 مقاعد بتصميم فخم)
              GridView.builder(
                shrinkWrap: true,
                physics: const NeverScrollableScrollPhysics(),
                itemCount: 9,
                gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                  crossAxisCount: 3,
                  mainAxisSpacing: 20,
                  crossAxisSpacing: 20,
                  childAspectRatio: 0.9,
                ),
                itemBuilder: (context, index) {
                  final seat = _seats[index];
                  bool isOccupied = seat['isOccupied'];

                  return GestureDetector(
                    onTap: () {
                      setState(() {
                        if (!isOccupied) {
                          _seats[index] = {'name': 'أنت', 'isMuted': false, 'isOccupied': true, 'avatar': '⭐'};
                        } else {
                          ScaffoldMessenger.of(context).showSnackBar(
                            SnackBar(content: Text('الضغط على ${seat['name']}')),
                          );
                        }
                      });
                    },
                    child: Column(
                      children: [
                        Stack(
                          alignment: Alignment.bottomRight,
                          children: [
                            Container(
                              width: 65,
                              height: 65,
                              decoration: BoxDecoration(
                                shape: BoxShape.circle,
                                color: isOccupied ? Colors.purple.withOpacity(0.3) : Colors.white.withOpacity(0.05),
                                border: Border.all(
                                  color: isOccupied ? Colors.amberAccent : Colors.white24,
                                  width: 2,
                                ),
                              ),
                              child: Center(
                                child: Text(
                                  seat['avatar'],
                                  style: TextStyle(fontSize: isOccupied ? 24 : 20, color: Colors.white),
                                ),
                              ),
                            ),
                            if (isOccupied)
                              Container(
                                padding: const EdgeInsets.all(4),
                                decoration: const BoxDecoration(
                                  color: Colors.black,
                                  shape: BoxShape.circle,
                                ),
                                child: Icon(
                                  seat['isMuted'] ? Icons.mic_off : Icons.mic,
                                  size: 12,
                                  color: seat['isMuted'] ? Colors.redAccent : Colors.greenAccent,
                                ),
                              ),
                          ],
                        ),
                        const SizedBox(height: 6),
                        Text(
                          seat['name'],
                          style: TextStyle(
                            color: isOccupied ? Colors.white : Colors.white54,
                            fontSize: 11,
                            fontWeight: FontWeight.bold,
                          ),
                          overflow: TextOverflow.ellipsis,
                        ),
                      ],
                    ),
                  );
                },
              ),
              const Spacer(),

              // شات الغرفة الصوتية السفلي
              Container(
                height: 140,
                decoration: BoxDecoration(
                  color: Colors.black.withOpacity(0.3),
                  borderRadius: BorderRadius.circular(16),
                  border: Border.all(color: Colors.white10),
                ),
                child: ListView(
                  padding: const EdgeInsets.all(8),
                  children: const [
                    Text('أحمد: منورين الغرفة يا شباب 🎤', style: TextStyle(color: Colors.amberAccent, fontSize: 12)),
                    SizedBox(height: 4),
                    Text('سارة: الصوت نقي جداً ما شاء الله ✨', style: TextStyle(color: Colors.white, fontSize: 12)),
                    SizedBox(height: 4),
                    Text('نظام الهدايا: أرسل محمد وردة للمضيف 🌹', style: TextStyle(color: Colors.purpleAccent, fontSize: 12)),
                  ],
                ),
              ),
              const SizedBox(height: 12),

              // شريط التحكم بالصوت والمايك والهدايا داخل الغرفة
              Row(
                mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                children: [
                  IconButton(
                    onPressed: () {},
                    icon: const Icon(Icons.mic, color: Colors.white),
                    style: IconButton.styleFrom(backgroundColor: Colors.purple.withOpacity(0.5)),
                  ),
                  IconButton(
                    onPressed: () {},
                    icon: const Icon(Icons.chat_bubble_outline, color: Colors.white),
                    style: IconButton.styleFrom(backgroundColor: Colors.white.withOpacity(0.1)),
                  ),
                  IconButton(
                    onPressed: () {},
                    icon: const Icon(Icons.card_giftcard, color: Colors.amberAccent),
                    style: IconButton.styleFrom(backgroundColor: Colors.amber.withOpacity(0.2)),
                  ),
                  IconButton(
                    onPressed: () {},
                    icon: const Icon(Icons.share, color: Colors.white),
                    style: IconButton.styleFrom(backgroundColor: Colors.white.withOpacity(0.1)),
                  ),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }
}
